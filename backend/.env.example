PORT=5000

# Relational Database (MySQL 8)
DATABASE_URL="mysql://root:trustpay_root_pass@localhost:3306/trustpay"
DB_SSL=false

# Authentication
JWT_SECRET="your_jwt_secret_here"

# Sentinel AI Microservice (Synchronous Fallback Endpoint)
ML_SERVICE_URL="http://localhost:8000"

# Phase 1: RabbitMQ Asynchronous Message Queue
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
FRAUD_EVALUATION_QUEUE="fraud_evaluation_queue"

# Phase 2: Redis Caching & Sliding-Window Rate Limiter
REDIS_URL="redis://localhost:6379"
