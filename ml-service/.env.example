PORT=8000

# Relational Database (MySQL 8)
DATABASE_URL=mysql://root:trustpay_root_pass@localhost:3306/trustpay

# Groq Cloud LLM Forensic Analyst
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LightGBM Model Artifact Path
ML_MODEL_PATH=app/model/fraud_model.joblib

# Phase 1: RabbitMQ Asynchronous Consumer Worker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
FRAUD_EVALUATION_QUEUE=fraud_evaluation_queue