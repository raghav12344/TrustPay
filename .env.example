# ==============================================================================
# TRUSTPAY ENTERPRISE STACK - DOCKER COMPOSE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. MySQL 8 Relational Database
MYSQL_ROOT_PASSWORD=trustpay_root_pass
MYSQL_DATABASE=trustpay
DATABASE_URL=mysql://root:trustpay_root_pass@db:3306/trustpay
DB_SSL=false

# 2. Backend Express API Gateway
PORT=5000
JWT_SECRET=trustpay_super_secret_jwt_key_2026

# 3. RabbitMQ Message Broker (AMQP + Management UI)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
FRAUD_EVALUATION_QUEUE=fraud_evaluation_queue

# 4. Redis Cache & Sliding-Window Rate Limiter
REDIS_URL=redis://redis:6379

# 5. FastAPI Sentinel ML & GenAI Service
ML_SERVICE_URL=http://ml-service:8000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ML_MODEL_PATH=app/model/fraud_model.joblib

# 6. React + Vite Frontend
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
